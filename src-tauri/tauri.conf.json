{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIPTrace",
  "mainBinaryName": "SIPTrace",
  "version": "1.1.0",
  "identifier": "ru.siptrace.eda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SIPTrace",
        "width": 414,
        "height": 648,
        "minWidth": 390,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
